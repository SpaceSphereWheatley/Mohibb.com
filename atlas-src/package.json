    "react-dom": "19.2.0",
    "react-grid-layout": "2.2.4",
    "uplot": "1.6.32",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.18.1",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
